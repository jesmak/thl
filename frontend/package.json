{
    "name": "thl-card",
    "description": "The dashboard card that comes with the THL disease statistics integration, drawing THL's weekly disease numbers on a map of Finland",
    "keywords": [
        "home-assistant",
        "homeassistant",
        "hass",
        "lovelace",
        "custom-cards",
        "disease",
        "thl"
    ],
    "type": "module",
    "private": true,
    "license": "MIT",
    "repository": "git@github.com:jesmak/thl.git",
    "engines": {
        "node": ">=22.13"
    },
    "scripts": {
        "build": "node scripts/build.mjs",
        "typecheck": "tsc",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:watch": "vitest",
        "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build"
    },
    "dependencies": {
        "lit": "^3.3.3"
    },
    "devDependencies": {
        "@eslint/compat": "^2.1.1",
        "@eslint/js": "^10.0.1",
        "esbuild": "^0.28.2",
        "eslint": "^10.13.0",
        "happy-dom": "^21.0.4",
        "prettier": "^3.9.10",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.72.1",
        "vitest": "^5.0.5"
    }
}
